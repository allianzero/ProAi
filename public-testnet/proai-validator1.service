[Unit]
Description=ProAi Validator 1 (chain 505)
After=network-online.target
Wants=network-online.target

[Service]
User=proai
WorkingDirectory=/home/proai/proai-chain
ExecStart=/home/proai/proai-chain/bin/geth113 --datadir /home/proai/proai-chain/data --networkid 505 --http --http.addr 127.0.0.1 --http.port 8545 --http.api eth,net,web3,clique --http.corsdomain '*' --unlock 0x74EA90D9f08C6556AE4d260A6dCC04A84BF86184 --password /home/proai/proai-chain/password.txt --mine --miner.etherbase 0x74EA90D9f08C6556AE4d260A6dCC04A84BF86184 --allow-insecure-unlock --syncmode full
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
